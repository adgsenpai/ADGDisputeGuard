APP_URL=http://localhost:3100
# Disable open persona login when using registered accounts only.
SHOWCASE_DEMO_LOGIN=true
# Set a long random value to enable first-admin setup on the sign-in screen.
ADMIN_SETUP_TOKEN=
# Set true behind HTTPS.
COOKIE_SECURE=false
# Use an absolute path on a persistent local volume.
# DATA_DIR=/absolute/path/to/disputeguard-data
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
# Preview inbox is the default; only an explicit true enables SMTP delivery.
EMAIL_DELIVERY_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
