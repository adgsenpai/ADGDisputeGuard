# DisputeGuard environment (copy to .env for docker-compose, or export locally).

# Ollama server used by the bounded investigation. In the compose stack this
# is the internal service URL; for local `npm run dev` use http://localhost:11434.
OLLAMA_BASE_URL=http://localhost:11434

# The local model to use. It must be pulled into Ollama (see infra/pull-model.sh).
OLLAMA_MODEL=llama3.2

# Per-request timeout for the model, in milliseconds. The investigation falls
# back to a deterministic proposer if the model is slow or unreachable.
OLLAMA_TIMEOUT_MS=20000
